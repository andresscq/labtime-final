# Copiar a .env y completar. Este archivo (.env.example) SI se versiona;
# .env NUNCA se versiona (ver .gitignore).

# ---- Cognito (ambos microservicios deben resolver el MISMO issuer) ----
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx

# ---- users-db ----
USERS_DB_USER=users_user
USERS_DB_PASSWORD=change-me

# ---- labtime-db ----
LABTIME_DB_USER=labtime_user
LABTIME_DB_PASSWORD=change-me
